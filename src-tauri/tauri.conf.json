{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LaTeX Editor",
  "version": "2.0.0",
  "identifier": "com.latex.editor",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LaTeX Editor",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "copyright": "Copyright © 2026 Shounak Saha",
    "shortDescription": "100% offline native LaTeX Editor",
    "longDescription": "A lightweight, crash-free 100% offline native desktop LaTeX editor built with Tauri and Rust.",
    "fileAssociations": [
      {
        "ext": ["tex", "latex", "ltx"],
        "name": "LaTeX Document",
        "description": "LaTeX Source File",
        "role": "Editor"
      },
      {
        "ext": ["txt", "md"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      }
    }
  }
}
